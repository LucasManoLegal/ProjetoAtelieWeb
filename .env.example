# Configurações do Banco de Dados PostgreSQL (Ateliê Haiti)
# Você pode configurar via DATABASE_URL única ou parâmetros separados:

# Opção 1: DATABASE_URL (Recomendado)
# DATABASE_URL=postgresql://root:Senai%40444@172.16.36.14:5432/postgres?sslmode=prefer

# Opção 2: Parâmetros Individuais
PGHOST=172.16.36.14
PGPORT=5432
PGDATABASE=postgres
PGUSER=root
PGPASSWORD=Senai@444
PGSSLMODE=prefer

# Para forçar o uso do SQLite local mesmo com variáveis PG definidas, descomente:
# DB_ENGINE=sqlite
